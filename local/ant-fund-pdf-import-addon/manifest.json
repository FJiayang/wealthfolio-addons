{
  "id": "ant-fund-pdf-import-addon",
  "name": "Ant Fund PDF Import",
  "version": "0.1.1",
  "description": "Import Ant Fund transaction statements locally with a review before saving.",
  "author": "Local fork maintainer",
  "main": "dist/addon.js",
  "sdkVersion": "3.11.0",
  "minWealthfolioVersion": "3.11.0",
  "enabled": true,
  "contributes": {
    "routes": [
      {
        "id": "ant-fund-pdf-import"
      }
    ],
    "links": {
      "sidebar": [
        {
          "id": "ant-fund-pdf-import",
          "route": "ant-fund-pdf-import",
          "label": "蚂蚁基金 PDF / Ant Fund PDF",
          "icon": "receipt",
          "order": 220
        }
      ]
    }
  },
  "hostDependencies": {
    "@wealthfolio/addon-sdk": "^3.11.0",
    "@wealthfolio/ui": "^3.11.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "permissions": [
    {
      "category": "accounts",
      "functions": ["getAll"],
      "purpose": "Select an existing CNY investment account."
    },
    {
      "category": "activities",
      "functions": ["openImport"],
      "purpose": "Open the host import wizard with locally parsed drafts; the host reviews and saves."
    }
  ]
}
