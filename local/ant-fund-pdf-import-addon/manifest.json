{
  "id": "ant-fund-pdf-import-addon",
  "name": "蚂蚁基金 PDF 导入",
  "version": "0.1.3",
  "description": "本地解析蚂蚁基金交易明细，核对后交由 Wealthfolio 审核并导入。",
  "author": "Local fork maintainer",
  "main": "dist/addon.js",
  "sdkVersion": "3.11.0",
  "minWealthfolioVersion": "3.11.0",
  "enabled": true,
  "contributes": {
    "routes": [
      {
        "id": "ant-fund-pdf-import"
      }
    ],
    "links": {
      "investment-import": [
        {
          "id": "ant-fund-pdf-import",
          "route": "ant-fund-pdf-import",
          "label": "蚂蚁基金 PDF 导入",
          "icon": "receipt",
          "order": 220
        }
      ]
    }
  },
  "hostDependencies": {
    "@wealthfolio/addon-sdk": "^3.11.0",
    "@wealthfolio/ui": "^3.11.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "permissions": [
    {
      "category": "accounts",
      "functions": ["getAll"],
      "purpose": "选择已有的人民币投资账户。"
    },
    {
      "category": "activities",
      "functions": ["openImport"],
      "purpose": "将本地解析的草稿交给宿主导入向导，审核确认后保存。"
    }
  ]
}
