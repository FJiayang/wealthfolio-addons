{
  "id": "unified-statement-import-addon",
  "name": "账单导入",
  "version": "0.4.2",
  "description": "本地解析支付平台与银行表格及 PDF，核对来源、自动关联消费、拆分手续费并关联真实转账。",
  "author": "Local fork maintainer",
  "main": "dist/addon.js",
  "sdkVersion": "3.12.0",
  "minWealthfolioVersion": "3.12.0",
  "enabled": true,
  "contributes": {
    "routes": [
      {
        "id": "statement-import"
      }
    ],
    "links": {
      "investment-import": [
        {
          "id": "statement-investment-import",
          "route": "statement-import",
          "label": "账单导入",
          "icon": "receipt",
          "order": 230
        }
      ],
      "spending-import": [
        {
          "id": "statement-import",
          "route": "statement-import",
          "label": "账单导入",
          "icon": "receipt",
          "order": 230
        }
      ]
    }
  },
  "hostDependencies": {
    "@wealthfolio/addon-sdk": "^3.12.0",
    "@wealthfolio/ui": "^3.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "permissions": [
    {
      "category": "accounts",
      "functions": ["getAll"],
      "purpose": "按名称推荐并选择已有账户。"
    },
    {
      "category": "activities",
      "functions": ["getAll", "saveMany", "getTransferPair", "linkTransfer", "checkImport"],
      "purpose": "读取来源检测重复，保存审核后的流水，并更新或取消银行与三方消费关联及对应记账金额。"
    },
    {
      "category": "market",
      "functions": ["searchTicker"],
      "purpose": "通过宿主已有行情源识别并人工选择基金资产。"
    }
  ]
}
