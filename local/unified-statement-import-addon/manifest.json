{
  "id": "unified-statement-import-addon",
  "name": "账单导入",
  "version": "0.2.1",
  "description": "本地解析支付平台与银行账单，映射账户、核对来源、拆分手续费并关联真实转账。",
  "author": "Local fork maintainer",
  "main": "dist/addon.js",
  "sdkVersion": "3.11.0",
  "minWealthfolioVersion": "3.11.0",
  "enabled": true,
  "contributes": {
    "routes": [
      {
        "id": "statement-import"
      }
    ],
    "links": {
      "spending-import": [
        {
          "id": "statement-import",
          "route": "statement-import",
          "label": "账单导入",
          "icon": "receipt",
          "order": 230
        }
      ]
    }
  },
  "hostDependencies": {
    "@wealthfolio/addon-sdk": "^3.11.0",
    "@wealthfolio/ui": "^3.11.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "permissions": [
    {
      "category": "accounts",
      "functions": ["getAll"],
      "purpose": "按名称推荐并选择已有账户。"
    },
    {
      "category": "activities",
      "functions": ["getAll", "saveMany", "getTransferPair", "linkTransfer"],
      "purpose": "读取来源以检测重复，并保存用户确认的新增记录。"
    }
  ]
}
